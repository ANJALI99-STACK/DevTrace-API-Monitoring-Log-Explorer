{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/home/ubuntu/logs/devtrace-api-out.log",
            "log_group_name": "/devtrace/api",
            "log_stream_name": "{instance_id}/out",
            "timestamp_format": "%Y-%m-%d %H:%M:%S"
          },
          {
            "file_path": "/home/ubuntu/logs/devtrace-api-error.log",
            "log_group_name": "/devtrace/api",
            "log_stream_name": "{instance_id}/error",
            "timestamp_format": "%Y-%m-%d %H:%M:%S"
          },
          {
            "file_path": "/home/ubuntu/logs/devtrace-worker-out.log",
            "log_group_name": "/devtrace/worker",
            "log_stream_name": "{instance_id}/out",
            "timestamp_format": "%Y-%m-%d %H:%M:%S"
          },
          {
            "file_path": "/home/ubuntu/logs/devtrace-worker-error.log",
            "log_group_name": "/devtrace/worker",
            "log_stream_name": "{instance_id}/error",
            "timestamp_format": "%Y-%m-%d %H:%M:%S"
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "DevTrace",
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] },
      "cpu": { "measurement": ["cpu_usage_idle", "cpu_usage_user"], "totalcpu": true }
    }
  }
}
