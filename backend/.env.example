# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Mongo
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/devtrace

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# OpenSearch
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_INDEX=healthlogs

# Nodemailer (use an app password, never your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL_FROM="DevTrace Alerts <alerts@devtrace.app>"

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=devtrace-exports

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
